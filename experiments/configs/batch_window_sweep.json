{
  "description": "Window length sweep experiment on FD002",
  
  "global_settings": {
    "dataset_name": "FD002",
    "model_params": {
      "num_heads": 4,
      "temperature": 1.6,
      "attn_dropout": 0.15,
      "use_pos_encoding": true,
      "hidden_dim": 96,
      "num_blocks": 3,
      "dropout": 0.15
    },
    "training_params": {
      "epochs": 50,
      "batch_size": 128,
      "lr": 0.0008,
      "weight_decay": 2e-5,
      "lr_scheduler": true,
      "patience": 10
    }
  },
  
  "experiments": [
    {
      "experiment_name": "window_30",
      "description": "Window length = 30",
      "data_params": {
        "window_sample": 30,
        "patch_size": 5,
        "time_denpen_len": 6,
        "max_rul": 125
      },
      "model_params": {
        "num_tokens": 12,
        "token_dim": 64
      }
    },
    {
      "experiment_name": "window_40",
      "description": "Window length = 40",
      "data_params": {
        "window_sample": 40,
        "patch_size": 5,
        "time_denpen_len": 8,
        "max_rul": 125
      },
      "model_params": {
        "num_tokens": 14,
        "token_dim": 64
      }
    },
    {
      "experiment_name": "window_50",
      "description": "Window length = 50 (baseline)",
      "data_params": {
        "window_sample": 50,
        "patch_size": 5,
        "time_denpen_len": 10,
        "max_rul": 125
      },
      "model_params": {
        "num_tokens": 16,
        "token_dim": 64
      }
    },
    {
      "experiment_name": "window_60",
      "description": "Window length = 60",
      "data_params": {
        "window_sample": 60,
        "patch_size": 5,
        "time_denpen_len": 12,
        "max_rul": 125
      },
      "model_params": {
        "num_tokens": 18,
        "token_dim": 64
      }
    }
  ]
}

