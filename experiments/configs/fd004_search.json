{
  "description": "FD004 Score-Oriented & Balanced Search",
  "base_config": {
    "dataset_name": "FD004",
    "seed": 42,
    "data_params": {
      "patch_size": 5,
      "max_rul": 125
    },
    "model_params": {
      "num_heads": 4,
      "temperature": 1.4,
      "attn_dropout": 0.10,
      "use_pos_encoding": true,
      "hidden_dim": 96,
      "num_blocks": 3,
      "dropout": 0.10
    },
    "training_params": {
      "epochs": 60,
      "batch_size": 128,
      "lr": 0.0010,
      "weight_decay": 5e-5,
      "lr_scheduler": true,
      "patience": 12,
      "lr_decay_factor": 0.5,
      "lr_patience": 4
    },
    "output": {
      "save_checkpoint": true,
      "save_predictions": true,
      "save_attention_weights": false
    }
  },
  "experiments": [
    {
      "experiment_name": "fd004_w50_t12_tdim96_balance",
      "description": "平衡版：window=50, tokens=12, token_dim=96（在baseline附近折中）",
      "data_params": { "window_sample": 50, "time_denpen_len": 10 },
      "model_params": { "num_tokens": 12, "token_dim": 96 }
    },
    {
      "experiment_name": "fd004_w55_t14_tdim96_score",
      "description": "在baseline附近略降容量以稳Score",
      "data_params": { "window_sample": 55, "time_denpen_len": 11 },
      "model_params": { "num_tokens": 14, "token_dim": 96 }
    },
    {
      "experiment_name": "fd004_w50_t12_tdim112_compact",
      "description": "小窗+中等token_dim，延续你w50的优势，降低过拟合风险",
      "data_params": { "window_sample": 50, "time_denpen_len": 10 },
      "model_params": { "num_tokens": 12, "token_dim": 112, "num_heads": 4 }
    },
    {
      "experiment_name": "fd004_w60_t10_tdim112_score_guard",
      "description": "略大窗+少tokens，弱化过锐注意力以改善PHM Score",
      "data_params": { "window_sample": 60, "time_denpen_len": 12 },
      "model_params": { "num_tokens": 10, "token_dim": 112, "temperature": 1.3 }
    },
    {
      "experiment_name": "fd004_w55_t16_tdim96_clipreg",
      "description": "贴近baseline，轻正则和更激进LR，期望提升Score不牺牲RMSE",
      "data_params": { "window_sample": 55, "time_denpen_len": 11 },
      "model_params": { "num_tokens": 16, "token_dim": 96 },
      "training_params": { "lr": 0.0012, "weight_decay": 2e-5, "patience": 15, "lr_patience": 5 }
    },
    {
      "experiment_name": "fd004_w50_t12_tdim88_smallwin",
      "description": "更小的窗口减少尾部误差放大，常能稳住Score",
      "data_params": { "window_sample": 50, "time_denpen_len": 10 },
      "model_params": { "num_tokens": 12, "token_dim": 88 }
    }
  ]
}
