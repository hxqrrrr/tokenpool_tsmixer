{
  "description": "FD001 Token Dimension Controlled Experiment - Fixed hidden_dim=96, varying token_dim 80-128",
  "base_config": {
    "dataset_name": "FD001",
    "seed": 42,
    "data_params": {
      "window_sample": 30,
      "time_denpen_len": 6,
      "patch_size": 5,
      "max_rul": 125
    },
    "model_params": {
      "num_tokens": 12,
      "num_heads": 4,
      "temperature": 1.5,
      "attn_dropout": 0.1,
      "use_pos_encoding": true,
      "hidden_dim": 64,
      "dropout": 0.1,
      "num_blocks": 4
    },
    "training_params": {
      "epochs": 50,
      "batch_size": 128,
      "lr": 0.001,
      "weight_decay": 2e-5,
      "lr_scheduler": true,
      "patience": 15,
      "lr_decay_factor": 0.5,
      "lr_patience": 5
    },
    "output": {
      "save_checkpoint": true,
      "save_predictions": true,
      "save_attention_weights": false
    }
  },
  
  "experiments": [
    {
      "experiment_name": "fd001_tdim80_hdim96",
      "description": "TokenDim=80, HiddenDim=96 (fixed)",
      "model_params": {
        "token_dim": 80
      }
    },
    {
      "experiment_name": "fd001_tdim88_hdim96",
      "description": "TokenDim=88, HiddenDim=96 (fixed)",
      "model_params": {
        "token_dim": 88
      }
    },
    {
      "experiment_name": "fd001_tdim96_hdim96",
      "description": "TokenDim=96, HiddenDim=96 (fixed)",
      "model_params": {
        "token_dim": 96
      }
    },
    {
      "experiment_name": "fd001_tdim104_hdim96",
      "description": "TokenDim=104, HiddenDim=96 (fixed)",
      "model_params": {
        "token_dim": 104
      }
    },
    {
      "experiment_name": "fd001_tdim112_hdim96",
      "description": "TokenDim=112, HiddenDim=96 (fixed)",
      "model_params": {
        "token_dim": 112
      }
    },
    {
      "experiment_name": "fd001_tdim120_hdim96",
      "description": "TokenDim=120, HiddenDim=96 (fixed)",
      "model_params": {
        "token_dim": 120
      }
    },
    {
      "experiment_name": "fd001_tdim128_hdim96",
      "description": "TokenDim=128, HiddenDim=96 (fixed)",
      "model_params": {
