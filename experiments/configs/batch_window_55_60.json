        "attn_dropout": 0.15,
        "use_pos_encoding": true,
        "hidden_dim": 64,
        "num_blocks": 4,
        "dropout": 0.15
      },
      
      "training_params": {
        "epochs": 50,
        "batch_size": 128,
        "lr": 0.0008,
        "weight_decay": 2e-5,
        "lr_scheduler": true,
        "patience": 10,
        "lr_decay_factor": 0.5,
        "lr_patience": 5
      },
      
      "output": {
        "save_checkpoint": true,
        "save_predictions": true,
        "save_attention_weights": false
      }
    }
