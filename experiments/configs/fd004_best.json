{
  "experiment_name": "fd004_best",
  "description": "FD004 Best Configuration - Window=55, Tokens=16, TokenDim=88, Expected RMSE~13.89",
  "dataset_name": "FD004",
  "seed": 42,
  
  "data_params": {
    "window_sample": 55,
    "patch_size": 5,
    "time_denpen_len": 11,
    "max_rul": 125
  },
  
  "model_params": {
    "num_tokens": 16,
    "token_dim": 88,
    "hidden_dim": 96,
    "num_heads": 4,
    "temperature": 1.6,
    "attn_dropout": 0.15,
    "use_pos_encoding": true,
    "dropout": 0.15,
    "num_blocks": 3
  },
  
  "training_params": {
    "epochs": 50,
    "batch_size": 128,
    "lr": 0.0008,
    "weight_decay": 2e-5,
    "lr_scheduler": true,
    "patience": 15,
    "lr_decay_factor": 0.5,
    "lr_patience": 5
  },
  
  "output": {
    "save_checkpoint": true,
    "save_predictions": true,
    "save_attention_weights": false
  }
}
