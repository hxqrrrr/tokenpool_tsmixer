{
  "experiment_name": "baseline_fd001",
  "dataset_name": "FD001",
  "description": "Baseline experiment for FD001 dataset",
  
  "data_params": {
    "window_sample": 30,
    "patch_size": 5,
    "time_denpen_len": 6,
    "max_rul": 125
  },
  
  "model_params": {
    "num_tokens": 10,
    "token_dim": 128,
    "num_heads": 4,
    "temperature": 1.5,
    "attn_dropout": 0.1,
    "use_pos_encoding": true,
    "hidden_dim": 64,
    "num_blocks": 4,
    "dropout": 0.1
  },
  
  "training_params": {
    "epochs": 50,
    "batch_size": 128,
    "lr": 0.001,
    "weight_decay": 1e-5,
    "lr_scheduler": true,
    "patience": 10,
    "lr_decay_factor": 0.5,
    "lr_patience": 5
  },
  
  "output": {
    "save_checkpoint": true,
    "save_predictions": true,
    "save_attention_weights": false
  }
}

